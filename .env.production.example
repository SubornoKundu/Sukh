# Copy to .env on the SERVER (cp .env.production.example .env), then fill the CHANGE lines
# and run: php artisan key:generate
# Then:    bash deploy/deploy.sh        (add --demo for a client demo site)

APP_NAME=ShopEase
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://example.com                 # CHANGE: your real address, with https

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopease                        # CHANGE
DB_USERNAME=shopease                        # CHANGE (do not use root)
DB_PASSWORD=                                # CHANGE

# database = no extra software needed. Switch these three to redis if you have Redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database                   # needs the worker: deploy/supervisor-queue.conf.example
FILESYSTEM_DISK=public

# Real email (order mails, password reset, OTP). Example: Gmail app password or any SMTP service.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com                  # CHANGE
MAIL_PORT=587
MAIL_USERNAME=                              # CHANGE
MAIL_PASSWORD=                              # CHANGE
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@example.com"    # CHANGE
MAIL_FROM_NAME="${APP_NAME}"

# Behind Cloudflare / a load balancer / a hosting proxy? Uncomment so real visitor IPs are used.
# TRUSTED_PROXIES=*

VITE_APP_NAME="${APP_NAME}"

OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5

# ---- Real shop: keep both false.  Client demo site: set both to true.
SHOP_DEMO_LOGIN=false
# Admin > Settings (name, logo, colours) is hidden from the admin panel unless this is true.
# Hand-over site: keep false. To edit yourself: set true, save, change things, set back to false.
SHOP_SETTINGS_ACCESS=false
OTP_DEBUG_DISPLAY=false

# Payment gateway (demo gateway until you put real SSLCommerz keys in services.php)
SSLCOMMERZ_STORE_ID=shopease_demo
SSLCOMMERZ_STORE_PASSWORD=demo_password

# Shop numbers
SHOP_SHIPPING_FEE=60
SHOP_FREE_SHIPPING_OVER=5000
SHOP_LOW_STOCK_THRESHOLD=5
SHOP_STOREFRONT_CACHE=120
SHOP_POPULAR_CACHE=600
SHOP_STATS_CACHE=120
