APP_NAME=ShopEase
APP_ENV=local
APP_KEY=
# Keep this false on a live / client-facing site (true shows file paths and code on errors).
# Set it to true only on your own computer while developing.
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# As required by the assignment brief, ShopEase runs on MySQL.
# Create an empty database first, e.g.: CREATE DATABASE shopease;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopease
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# OTPs are emailed. The "log" driver (default below) writes the email
# -- OTP code included -- to storage/logs/laravel.log instead of sending
# a real email, which is perfect for local development and for recording
# the demo video without needing a real mailbox. Swap in real SMTP
# credentials (e.g. Gmail, Mailtrap) to deliver actual emails.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@shopease.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# One-time password settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5

# Demo SSLCommerz gateway (no real merchant account needed -- see README)
SSLCOMMERZ_STORE_ID=shopease_demo
SSLCOMMERZ_STORE_PASSWORD=demo_password
SSLCOMMERZ_SANDBOX=true

# --- Shop settings (optional) ---
SHOP_SHIPPING_FEE=60
SHOP_FREE_SHIPPING_OVER=5000
SHOP_LOW_STOCK_THRESHOLD=5

# Store contact / social (footer, WhatsApp button)
SHOP_WHATSAPP=8801700000000
SHOP_PHONE="+880 1700-000000"
SHOP_EMAIL=support@shopease.test
SHOP_ADDRESS="House 12, Road 5, Dhanmondi, Dhaka 1209, Bangladesh"
SHOP_HOURS="Sat - Thu, 10:00 AM - 8:00 PM"
SHOP_BKASH_NUMBER=01700-000000
SHOP_NAGAD_NUMBER=01800-000000
SHOP_FACEBOOK=https://facebook.com
SHOP_INSTAGRAM=https://instagram.com
SHOP_YOUTUBE=https://youtube.com
SHOP_X=https://x.com
# Demo / "Google" one-click login. Set to false in production.
SHOP_DEMO_LOGIN=true
# Admin > Settings (name, logo, colours) is hidden from the admin panel unless this is true.
# Hand-over site: keep false. To edit yourself: set true, save, change things, set back to false.
SHOP_SETTINGS_ACCESS=true
